programa {
  funcao inicio() 
  {
        escreva("Instituição: Centro Universidade Una Aimores\n")

        cadeia pai, mae, aluno, periodo, curso

        escreva("Aluno: ")
        leia(aluno)

        escreva("Curso: ")
        leia(curso)

        escreva("Periodo: ")
        leia(periodo)

        escreva("Nome do Pai: ")
        leia(pai)

        escreva("Nome da mae: ")
        leia(mae)"\n"
        "\n"

        escreva("Resultado: \n")

        escreva("Nome do aluno: ",aluno,"\n")
        escreva("Nome do curso: ",curso,"\n")
        escreva("Periodo: ",periodo,"\n")
        escreva("Nome da mae: ",mae,"\n")
        escreva("nome do Pai: ",pai,"\n")





  }
}
